generator client {
  provider        = "prisma-client"
  output          = "../src/__generated__/client"
  moduleFormat    = "cjs"
  previewFeatures = ["fullTextSearchPostgres", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum RevoProjectKind {
  USER
  SYSTEM
}

enum RevoProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model RevoProject {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  kind      RevoProjectKind   @default(USER)
  name      String
  slug      String            @unique
  status    RevoProjectStatus @default(ACTIVE)

  revisiumBranches Branch[]
  taskRuns         TaskRun[]

  @@index([status])
  @@index([kind, status])
  @@index([deletedAt])
}

model TaskRun {
  id               String       @id
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  projectId        String?
  project          RevoProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title            String
  description      String       @default("")
  status           String
  repos            String[]
  scope            String       @default("")
  priority         Int          @default(0)
  playbookId       String       @default("")
  pipelineId       String       @default("")
  params           Json         @default("{}")
  routeDecision    Json         @default("{}")
  executionProfile Json         @default("{}")
  createdBy        String       @default("")

  tasks     RunTask[]
  events    RunEvent[]
  attempts  RunAttempt[]
  inbox     InboxItem[]
  outputs   RunOutput[]
  costItems CostLedgerEntry[]

  @@index([projectId])
  @@index([status])
  @@index([playbookId, pipelineId])
  @@index([createdAt])
}

model RunTask {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runId     String
  run       TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  repoRef   String   @default("")
  roleHint  String   @default("")
  title     String
  status    String
  dependsOn String[]
  scope     String   @default("")
  priority  Int      @default(0)

  @@index([runId])
  @@index([status])
  @@index([createdAt])
}

model RunEvent {
  id        String   @id
  createdAt DateTime @default(now())
  sequence  Int      @default(autoincrement())
  runId     String
  run       TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId    String   @default("")
  stepId    String   @default("")
  type      String
  payload   Json     @default("{}")
  actor     String   @default("")

  @@unique([runId, sequence])
  @@index([runId])
  @@index([runId, createdAt])
  @@index([runId, sequence])
  @@index([type])
}

model RunAttempt {
  id             String   @id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  runId          String
  run            TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId         String
  workerId       String   @default("")
  attemptNo      Int      @default(0)
  iteration      Int      @default(0)
  status         String
  idempotencyKey String   @default("")
  modelProfile   String   @default("")
  verdict        String   @default("")
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costAmount     Decimal  @default(0) @db.Decimal(20, 12)
  currency       String   @default("USD")
  durationMs     Int      @default(0)
  outputSummary  String   @default("")
  artifactRef    String   @default("")
  stdoutTail     String   @default("")
  stderrTail     String   @default("")
  lesson         String   @default("")
  error          String   @default("")
  startedAt      DateTime @default(now())
  finishedAt     DateTime @default(now())

  @@index([runId])
  @@index([runId, stepId])
  @@index([status])
}

model InboxItem {
  id         String    @id
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  kind       String
  runId      String?
  run        TaskRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId     String    @default("")
  stepId     String    @default("")
  projectId  String    @default("")
  title      String
  context    Json      @default("{}")
  options    String[]
  status     String
  answer     Json?
  resolvedBy String    @default("")
  resolvedAt DateTime?

  @@index([runId])
  @@index([status])
  @@index([createdAt])
}

model RunOutput {
  id         String   @id
  createdAt  DateTime @default(now())
  runId      String
  run        TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  ordinal    Int
  name       String
  schemaRef  String   @default("")
  payload    Json     @default("{}")
  payloadRef String   @default("")
  attemptId  String   @default("")
  producedAt DateTime @default(now())

  @@unique([runId, nodeId, ordinal])
  @@index([runId])
  @@index([nodeId])
  @@index([producedAt])
}

model CostLedgerEntry {
  id           String   @id
  createdAt    DateTime @default(now())
  runId        String
  run          TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId       String   @default("")
  attemptId    String   @default("")
  modelProfile String   @default("")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costAmount   Decimal  @default(0) @db.Decimal(20, 12)
  currency     String   @default("USD")
  recordedAt   DateTime @default(now())

  @@index([runId])
  @@index([attemptId])
  @@index([recordedAt])
}

model Branch {
  id          String      @id
  createdAt   DateTime    @default(now())
  isRoot      Boolean     @default(false)
  name        String
  projectId   String
  revoProject RevoProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions   Revision[]

  @@unique([name, projectId])
  @@index([projectId])
}

model Revision {
  id         String   @id
  sequence   Int      @unique @default(autoincrement())
  createdAt  DateTime @default(now())
  comment    String   @default("")
  isHead     Boolean  @default(false)
  isDraft    Boolean  @default(false)
  isStart    Boolean  @default(false)
  hasChanges Boolean  @default(false)

  branchId String
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Revision?  @relation("parentRevision", fields: [parentId], references: [id], onDelete: SetNull)
  children Revision[] @relation("parentRevision")
  tables   Table[]

  @@index([branchId])
}

model Table {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  system Boolean @default(false)

  revisions Revision[]
  rows      Row[]

  @@index([id])
}

model Row {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  data       Json
  meta       Json   @default("{}")
  hash       String
  schemaHash String

  tables    Table[]
  fileBlobs FileBlob[] @relation("FileBlobToRow")

  @@index([data], type: Gin)
  @@index([id])
  @@index([hash])
  @@index([schemaHash])
  @@index([publishedAt])
}

model FileBlob {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  projectId String
  hash      String
  size      BigInt

  rows Row[] @relation("FileBlobToRow")

  @@unique([projectId, hash])
  @@index([projectId])
  @@index([hash])
  @@index([deletedAt])
}

model ProjectFileUsage {
  projectId String   @id
  fileBytes BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model TableMigration {
  id                   String    @id @default(cuid())
  revisionId           String
  tableId              String
  sourceTableVersionId String
  shadowTableVersionId String?
  status               String    @default("PENDING")
  phase                String    @default("INIT")
  patches              Json
  previousSchema       Json
  previousSchemaHash   String
  targetSchemaHash     String
  totalRows            Int
  copiedRows           Int       @default(0)
  lastCopiedRowId      String?
  batchSize            Int       @default(1000)
  currentBatch         Int       @default(0)
  totalBatches         Int       @default(0)
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  lastProgressAt       DateTime?
  lockedBy             String?
  lockedAt             DateTime?
  heartbeatAt          DateTime?
  errorMessage         String?
  retryCount           Int       @default(0)
  maxRetries           Int       @default(3)

  @@unique([revisionId, tableId])
  @@index([status])
  @@index([lockedBy])
  @@index([status, heartbeatAt])
}
