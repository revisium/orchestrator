flowchart LR
  input[Pinned graph, state, and recorded result]
  core[Pure pipeline reducer]
  decision[One Decision]
  shell[DBOS durable effect shell]
  agent[Short-lived agent]
  effect[Bounded script or effect]
  gate[Human gate]
  wait[Wait or fork]
  recorded[Validated recorded result]

  input --> core --> decision --> shell
  shell --> agent
  shell --> effect
  shell --> gate
  shell --> wait
  agent --> recorded
  effect --> recorded
  gate --> recorded
  wait --> recorded
  recorded --> input

  classDef input fill:#fbfbfb,stroke:#7b7a75,color:#27231f
  classDef core fill:#f4f8ff,stroke:#2e6ec7,color:#27231f
  classDef worker fill:#f4fbf4,stroke:#4a8a52,color:#27231f
  classDef gate fill:#fff7ea,stroke:#d38318,color:#27231f
  classDef output fill:#fbf7ff,stroke:#6f5aa8,color:#27231f

  class input input
  class core,decision,shell core
  class agent,effect,wait worker
  class gate gate
  class recorded output
